{
  "functions": {
    "api/v3.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 60,
      "excludeFiles": "{sites/v1/**,sites/v2/**,sites/v4/**,sites/v5/**,sites/v3/assets/**,sites/v3/**/*.docx,sites/v3/**/*.zip,sites/v3/**/*.map,assets/**,.git/**,*.png,*.jpg,*.jpeg,*.webp,*.gif,*.mp4,*.svg,*.avif,*.docx,*.zip,*.pdf,*.woff,*.woff2,*.eot,*.ttf,*.map}"
    },
    "api/v4.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 60,
      "excludeFiles": "{sites/v1/**,sites/v2/**,sites/v3/**,sites/v5/**,sites/v4/assets/**,sites/v4/**/*.docx,sites/v4/**/*.zip,sites/v4/**/*.map,assets/**,.git/**,*.png,*.jpg,*.jpeg,*.webp,*.gif,*.mp4,*.svg,*.avif,*.docx,*.zip,*.pdf,*.woff,*.woff2,*.eot,*.ttf,*.map}"
    },
    "api/v5.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 60,
      "excludeFiles": "{sites/v1/**,sites/v2/**,sites/v3/**,sites/v4/**,sites/v5/assets/**,sites/v5/v4/**,sites/v5/**/*.docx,sites/v5/**/*.zip,sites/v5/**/*.map,assets/**,.git/**,*.png,*.jpg,*.jpeg,*.webp,*.gif,*.mp4,*.svg,*.avif,*.docx,*.zip,*.pdf,*.woff,*.woff2,*.eot,*.ttf,*.map}"
    }
  },
  "rewrites": [
    { "source": "/v1.1", "destination": "/sites/v1/index.html" },
    { "source": "/v1.1/", "destination": "/sites/v1/index.html" },
    { "source": "/v1.1/:path*", "destination": "/sites/v1/:path*" },
    { "source": "/v2.1", "destination": "/sites/v2/index.html" },
    { "source": "/v2.1/", "destination": "/sites/v2/index.html" },
    { "source": "/v2.1/:path*", "destination": "/sites/v2/:path*" },
    { "source": "/v3.1/assets/:path*", "destination": "/sites/v3/assets/:path*" },
    { "source": "/v3.1", "destination": "/api/v3.php" },
    { "source": "/v3.1/", "destination": "/api/v3.php" },
    { "source": "/v3.1/:path*", "destination": "/api/v3.php" },
    { "source": "/v4.1/assets/:path*", "destination": "/sites/v4/assets/:path*" },
    { "source": "/v4.1", "destination": "/api/v4.php" },
    { "source": "/v4.1/", "destination": "/api/v4.php" },
    { "source": "/v4.1/:path*", "destination": "/api/v4.php" },
    { "source": "/v5.1/assets/:path*", "destination": "/sites/v5/assets/:path*" },
    { "source": "/v5.1", "destination": "/api/v5.php" },
    { "source": "/v5.1/", "destination": "/api/v5.php" },
    { "source": "/v5.1/:path*", "destination": "/api/v5.php" }
  ]
}
