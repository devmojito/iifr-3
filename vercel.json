{
  "functions": {
    "api/v3.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 60,
      "excludeFiles": "{v1/**,v2/**,v3/assets/**,.git/**,*.png,*.jpg,*.jpeg,*.webp,*.gif,*.mp4,*.svg,*.avif,*.docx,*.zip,*.pdf}"
    }
  },
  "rewrites": [
    { "source": "/v3",        "destination": "/api/v3.php" },
    { "source": "/v3/",       "destination": "/api/v3.php" },
    { "source": "/v3/:path*", "destination": "/api/v3.php" }
  ]
}
