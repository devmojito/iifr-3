{
  "functions": {
    "api/v3.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 60,
      "includeFiles": "v3/app/**,v3/partials/**,v3/iifr-config.php,v3/iifr-config.local.php,v3/iifr-mail.php"
    }
  },
  "rewrites": [
    { "source": "/v3",        "destination": "/api/v3.php" },
    { "source": "/v3/",       "destination": "/api/v3.php" },
    { "source": "/v3/:path*", "destination": "/api/v3.php" }
  ]
}
