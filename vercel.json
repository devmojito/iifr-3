{
  "functions": {
    "api/v3.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 60,
      "excludeFiles": "{_v1/**,_v2/**,_v4/**,_v5/**,assets/**,.git/**,*.png,*.jpg,*.jpeg,*.webp,*.gif,*.mp4,*.svg,*.avif,*.docx,*.zip,*.pdf,*.woff,*.woff2,*.eot,*.ttf,*.map}"
    },
    "api/v4.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 60,
      "excludeFiles": "{_v1/**,_v2/**,_v3/**,_v5/**,assets/**,.git/**,*.png,*.jpg,*.jpeg,*.webp,*.gif,*.mp4,*.svg,*.avif,*.docx,*.zip,*.pdf,*.woff,*.woff2,*.eot,*.ttf,*.map}"
    },
    "api/v5.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 60,
      "excludeFiles": "{_v1/**,_v2/**,_v3/**,_v4/**,assets/**,.git/**,*.png,*.jpg,*.jpeg,*.webp,*.gif,*.mp4,*.svg,*.avif,*.docx,*.zip,*.pdf,*.woff,*.woff2,*.eot,*.ttf,*.map}"
    }
  },
  "rewrites": [
    { "source": "/v1.1", "destination": "/_v1/index.html" },
    { "source": "/v1.1/", "destination": "/_v1/index.html" },
    { "source": "/v1.1/:path*", "destination": "/_v1/:path*" },
    { "source": "/v2.1", "destination": "/_v2/index.html" },
    { "source": "/v2.1/", "destination": "/_v2/index.html" },
    { "source": "/v2.1/:path*", "destination": "/_v2/:path*" },
    { "source": "/v3.1/assets/:path*", "destination": "/_v3/assets/:path*" },
    { "source": "/v3.1", "destination": "/api/v3.php" },
    { "source": "/v3.1/", "destination": "/api/v3.php" },
    { "source": "/v3.1/:path*", "destination": "/api/v3.php" },
    { "source": "/v4.1/assets/:path*", "destination": "/_v4/assets/:path*" },
    { "source": "/v4.1", "destination": "/api/v4.php" },
    { "source": "/v4.1/", "destination": "/api/v4.php" },
    { "source": "/v4.1/:path*", "destination": "/api/v4.php" },
    { "source": "/v5.1/assets/:path*", "destination": "/_v5/assets/:path*" },
    { "source": "/v5.1", "destination": "/api/v5.php" },
    { "source": "/v5.1/", "destination": "/api/v5.php" },
    { "source": "/v5.1/:path*", "destination": "/api/v5.php" }
  ]
}
