{
  "functions": {
    "api/v3.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 60,
      "excludeFiles": "{v1/**,v2/**,v4/**,v5/**,**/assets/**,**/fonts/**,**/*.docx,**/*.zip,**/*.map,**/*.mp4,**/*.png,**/*.jpg,**/*.jpeg,**/*.webp,**/*.gif,**/*.svg,**/*.avif,**/*.pdf,**/*.woff,**/*.woff2,**/*.eot,**/*.ttf,assets/**,.git/**}"
    },
    "api/v4.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 60,
      "excludeFiles": "{v1/**,v2/**,v3/**,v5/**,**/assets/**,**/fonts/**,**/*.docx,**/*.zip,**/*.map,**/*.mp4,**/*.png,**/*.jpg,**/*.jpeg,**/*.webp,**/*.gif,**/*.svg,**/*.avif,**/*.pdf,**/*.woff,**/*.woff2,**/*.eot,**/*.ttf,assets/**,.git/**}"
    },
    "api/v5.php": {
      "runtime": "vercel-php@0.9.0",
      "maxDuration": 60,
      "excludeFiles": "{v1/**,v2/**,v3/**,v4/**,v5/v4/**,**/assets/**,**/fonts/**,**/*.docx,**/*.zip,**/*.map,**/*.mp4,**/*.png,**/*.jpg,**/*.jpeg,**/*.webp,**/*.gif,**/*.svg,**/*.avif,**/*.pdf,**/*.woff,**/*.woff2,**/*.eot,**/*.ttf,assets/**,.git/**}"
    }
  },
  "rewrites": [
    { "source": "/v1.1", "destination": "/v1/index.html" },
    { "source": "/v1.1/", "destination": "/v1/index.html" },
    { "source": "/v1.1/:path*", "destination": "/v1/:path*" },
    { "source": "/v2.1", "destination": "/v2/index.html" },
    { "source": "/v2.1/", "destination": "/v2/index.html" },
    { "source": "/v2.1/:path*", "destination": "/v2/:path*" },
    { "source": "/v3.1/assets/:path*", "destination": "/v3/assets/:path*" },
    { "source": "/v3.1", "destination": "/api/v3.php" },
    { "source": "/v3.1/", "destination": "/api/v3.php" },
    { "source": "/v3.1/:path*", "destination": "/api/v3.php" },
    { "source": "/v4.1/assets/:path*", "destination": "/v4/assets/:path*" },
    { "source": "/v4.1", "destination": "/api/v4.php" },
    { "source": "/v4.1/", "destination": "/api/v4.php" },
    { "source": "/v4.1/:path*", "destination": "/api/v4.php" },
    { "source": "/v5.1/assets/:path*", "destination": "/v5/assets/:path*" },
    { "source": "/v5.1", "destination": "/api/v5.php" },
    { "source": "/v5.1/", "destination": "/api/v5.php" },
    { "source": "/v5.1/:path*", "destination": "/api/v5.php" }
  ]
}
